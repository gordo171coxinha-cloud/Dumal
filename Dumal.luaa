local body=Instance.new("Frame")
body.Name="Body"; body.Size=UDim2.new(1,0,1,-36)
body.Position=UDim2.new(0,0,0,36)
body.BackgroundTransparency=1; body.Parent=main

local minimized=false
minBtn.MouseButton1Click:Connect(function()
    minimized=not minimized
    if minimized then
        TweenService:Create(main,TweenInfo.new(0.2),{Size=UDim2.new(0,560,0,36)}):Play()
        body.Visible=false; minBtn.Text="□"
    else
        TweenService:Create(main,TweenInfo.new(0.2),{Size=UDim2.new(0,560,0,420)}):Play()
        body.Visible=true; minBtn.Text="–"
    end
end)

UserInputService.InputBegan:Connect(function(i,gp)
    if not gp and i.KeyCode==Enum.KeyCode.Insert then
        main.Visible=not main.Visible
        if main.Visible and minimized then
            minimized=false
            main.Size=UDim2.new(0,560,0,420)
            body.Visible=true; minBtn.Text="–"
        end
    end
end)

local drag,dragStart,startPos=false,nil,nil
topbar.InputBegan:Connect(function(i)
    if i.UserInputType==Enum.UserInputType.MouseButton1 then
        drag=true; dragStart=i.Position; startPos=main.Position
    end
end)
UserInputService.InputChanged:Connect(function(i)
    if drag and i.UserInputType==Enum.UserInputType.MouseMovement then
        local d=i.Position-dragStart
        main.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+d.X,
                                startPos.Y.Scale,startPos.Y.Offset+d.Y)
    end
end)
UserInputService.InputEnded:Connect(function(i)
    if i.UserInputType==Enum.UserInputType.MouseButton1 then drag=false end
end)

local sidebar=Instance.new("Frame")
sidebar.Size=UDim2.new(0,110,1,0); sidebar.BackgroundColor3=C.panel
sidebar.BorderSizePixel=0; sidebar.Parent=body
Instance.new("UIListLayout",sidebar).SortOrder=Enum.SortOrder.LayoutOrder

local content=Instance.new("Frame")
content.Size=UDim2.new(1,-110,1,0); content.Position=UDim2.new(0,110,0,0)
content.BackgroundTransparency=1; content.Parent=body

local pages,tabBtns={},{}

local function makePage(name)
    local f=Instance.new("ScrollingFrame")
    f.Name=name; f.Size=UDim2.new(1,0,1,0)
    f.BackgroundTransparency=1; f.BorderSizePixel=0
    f.ScrollBarThickness=3; f.ScrollBarImageColor3=C.accent
    f.CanvasSize=UDim2.new(0,0,0,0)
    f.AutomaticCanvasSize=Enum.AutomaticSize.Y
    f.Visible=false; f.Parent=content
    local pad=Instance.new("UIPadding",f)
    pad.PaddingLeft=UDim.new(0,10); pad.PaddingTop=UDim.new(0,10); pad.PaddingRight=UDim.new(0,10)
    local layout=Instance.new("UIListLayout",f)
    layout.SortOrder=Enum.SortOrder.LayoutOrder; layout.Padding=UDim.new(0,6)
    pages[name]=f; return f
end

local function openTab(name)
    for n,p in pairs(pages)   do p.Visible=(n==name) end
    for n,b in pairs(tabBtns) do
        b.BackgroundColor3=(n==name) and C.accentD or C.panel
        b.TextColor3=(n==name) and C.white or C.textDim
    end
end

local function makeTab(name,icon,order)
    local btn=Instance.new("TextButton")
    btn.Size=UDim2.new(1,0,0,38); btn.BackgroundColor3=C.panel
    btn.BorderSizePixel=0; btn.Text=icon.."  "..name
    btn.TextColor3=C.textDim; btn.Font=Enum.Font.Gotham
    btn.TextSize=12; btn.LayoutOrder=order; btn.Parent=sidebar
    btn.MouseButton1Click:Connect(function() openTab(name) end)
    tabBtns[name]=btn
end

local function makeSection(parent,text)
    local l=Instance.new("TextLabel")
    l.Size=UDim2.new(1,0,0,20); l.BackgroundTransparency=1
    l.Text="── "..text.." ──"; l.TextColor3=C.accent
    l.Font=Enum.Font.GothamBold; l.TextSize=11
    l.TextXAlignment=Enum.TextXAlignment.Left; l.Parent=parent
end

local function makeLabel(parent,text)
    local l=Instance.new("TextLabel")
    l.Size=UDim2.new(1,0,0,16); l.BackgroundTransparency=1
    l.Text=text; l.TextColor3=C.textDim
    l.Font=Enum.Font.Code; l.TextSize=10
    l.TextXAlignment=Enum.TextXAlignment.Left
    l.TextWrapped=true; l.Parent=parent; return l
end

local function makeToggle(parent,label,key,sub,cb)
    local row=Instance.new("Frame")
    row.Size=UDim2.new(1,0,0,30); row.BackgroundColor3=Color3.fromRGB(20,22,45)
    row.BorderSizePixel=0; row.Parent=parent
    Instance.new("UICorner",row).CornerRadius=UDim.new(0,5)
    local lbl=Instance.new("TextLabel")
    lbl.Size=UDim2.new(1,-50,1,0); lbl.Position=UDim2.new(0,10,0,0)
    lbl.BackgroundTransparency=1; lbl.Text=label
    lbl.TextColor3=C.text; lbl.Font=Enum.Font.Gotham
    lbl.TextSize=12; lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.Parent=row
    local tog=Instance.new("TextButton")
    tog.Size=UDim2.new(0,36,0,18); tog.Position=UDim2.new(1,-44,0.5,-9)
    tog.BackgroundColor3=Color3.fromRGB(50,50,70); tog.Text=""
    tog.BorderSizePixel=0; tog.Parent=row
    Instance.new("UICorner",tog).CornerRadius=UDim.new(1,0)
    local knob=Instance.new("Frame")
    knob.Size=UDim2.new(0,14,0,14); knob.Position=UDim2.new(0,2,0.5,-7)
    knob.BackgroundColor3=C.white; knob.BorderSizePixel=0; knob.Parent=tog
    Instance.new("UICorner",knob).CornerRadius=UDim.new(1,0)
    local function refresh()
        local on=CFG[key][sub]
        TweenService:Create(tog,TweenInfo.new(0.15),
            {BackgroundColor3=on and C.accent or Color3.fromRGB(50,50,70)}):Play()
        TweenService:Create(knob,TweenInfo.new(0.15),
            {Position=on and UDim2.new(1,-16,0.5,-7) or UDim2.new(0,2,0.5,-7)}):Play()
    end
    refresh()
    tog.MouseButton1Click:Connect(function()
        CFG[key][sub]=not CFG[key][sub]; refresh()
        if cb then cb(CFG[key][sub]) end
    end)
end

local function makeSlider(parent,label,key,sub,mn,mx,cb)
    local row=Instance.new("Frame")
    row.Size=UDim2.new(1,0,0,44); row.BackgroundColor3=Color3.fromRGB(20,22,45)
    row.BorderSizePixel=0; row.Parent=parent
    Instance.new("UICorner",row).CornerRadius=UDim.new(0,5)
    local lbl=Instance.new("TextLabel")
    lbl.Size=UDim2.new(1,-10,0,18); lbl.Position=UDim2.new(0,10,0,4)
    lbl.BackgroundTransparency=1; lbl.TextColor3=C.text
    lbl.Font=Enum.Font.Gotham; lbl.TextSize=11
    lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.Parent=row
    local track=Instance.new("Frame")
    track.Size=UDim2.new(1,-20,0,6); track.Position=UDim2.new(0,10,0,28)
    track.BackgroundColor3=Color3.fromRGB(40,40,60); track.BorderSizePixel=0; track.Parent=row
    Instance.new("UICorner",track).CornerRadius=UDim.new(1,0)
    local fill=Instance.new("Frame")
    fill.BackgroundColor3=C.accent; fill.BorderSizePixel=0
    fill.Size=UDim2.new(0,0,1,0); fill.Parent=track
    Instance.new("UICorner",fill).CornerRadius=UDim.new(1,0)
    local function upd(v)
        CFG[key][sub]=v
        fill.Size=UDim2.new((v-mn)/(mx-mn),0,1,0)
        lbl.Text=label..":  "..tostring(math.floor(v))
        if cb then cb(v) end
    end
    upd(CFG[key][sub])
    local sliding=false
    track.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 then sliding=true end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 then sliding=false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if sliding and i.UserInputType==Enum.UserInputType.MouseMovement then
            local rel=(i.Position.X-track.AbsolutePosition.X)/track.AbsoluteSize.X
            upd(math.clamp(mn+rel*(mx-mn),mn,mx))
        end
    end)
end

local function makeDropdown(parent,label,opts,key,sub,cb)
    local row=Instance.new("Frame")
    row.Size=UDim2.new(1,0,0,50); row.BackgroundColor3=Color3.fromRGB(20,22,45)
    row.BorderSizePixel=0; row.ClipsDescendants=false; row.Parent=parent
    Instance.new("UICorner",row).CornerRadius=UDim.new(0,5)
    local lbl=Instance.new("TextLabel")
    lbl.Size=UDim2.new(1,-10,0,18); lbl.Position=UDim2.new(0,10,0,4)
    lbl.BackgroundTransparency=1; lbl.Text=label; lbl.TextColor3=C.textDim
    lbl.Font=Enum.Font.Gotham; lbl.TextSize=11
    lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.Parent=row
    local sel=Instance.new("TextButton")
    sel.Size=UDim2.new(1,-20,0,22); sel.Position=UDim2.new(0,10,0,22)
    sel.BackgroundColor3=C.accentD; sel.TextColor3=C.white
    sel.Font=Enum.Font.Gotham; sel.TextSize=11
    sel.Text=CFG[key][sub]; sel.BorderSizePixel=0; sel.Parent=row
    Instance.new("UICorner",sel).CornerRadius=UDim.new(0,4)
    local df=Instance.new("Frame")
    df.Size=UDim2.new(1,-20,0,#opts*22); df.Position=UDim2.new(0,10,0,50)
    df.BackgroundColor3=C.panel; df.BorderSizePixel=0
    df.Visible=false; df.ZIndex=10; df.Parent=row
    Instance.new("UICorner",df).CornerRadius=UDim.new(0,4)
    Instance.new("UIListLayout",df).SortOrder=Enum.SortOrder.LayoutOrder
    for i,opt in ipairs(opts) do
        local ob=Instance.new("TextButton")
        ob.Size=UDim2.new(1,0,0,22); ob.BackgroundTransparency=1
        ob.Text=opt; ob.TextColor3=C.text; ob.Font=Enum.Font.Gotham
        ob.TextSize=11; ob.LayoutOrder=i; ob.ZIndex=11; ob.Parent=df
        ob.MouseButton1Click:Connect(function()
            CFG[key][sub]=opt; sel.Text=opt; df.Visible=false
            if cb then cb(opt) end
        end)
    end
    sel.MouseButton1Click:Connect(function() df.Visible=not df.Visible end)
end

local function makeBtn(parent,label,cb)
    local btn=Instance.new("TextButton")
    btn.Size=UDim2.new(1,0,0,30); btn.BackgroundColor3=C.accentD
    btn.TextColor3=C.white; btn.Font=Enum.Font.GothamBold
    btn.TextSize=12; btn.Text=label; btn.BorderSizePixel=0; btn.Parent=parent
    Instance.new("UICorner",btn).CornerRadius=UDim.new(0,5)
    btn.MouseButton1Click:Connect(cb); return btn
end

