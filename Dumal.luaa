-- ================================================================
--  DUMAL MENU v1.3
--  Executor : Xeno
--  Fix      : aimbot via mousemoverel (universal)
-- ================================================================
local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local UserInputService  = game:GetService("UserInputService")
local TweenService      = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace         = game:GetService("Workspace")

local lp    = Players.LocalPlayer
local cam   = Workspace.CurrentCamera
local mouse = lp:GetMouse()

local function getParent()
    if gethui then return gethui() end
    return lp:WaitForChild("PlayerGui")
end

-- ══════════════════════════════════════════
--  CONFIG
-- ══════════════════════════════════════════
local CFG = {
    aimbot = {
        enabled    = false,
        silent     = false,
        target     = "Head",
        fov        = 120,
        smoothness = 0.15,   -- 0.01 snap / 1.0 lento
        showFov    = true,
        teamCheck  = false,
    },
    esp = {
        enabled    = false, boxes = true, names = true,
        distance   = true,  health = true, tracers = false,
        maxDist    = 1000,
        colorEnemy = Color3.fromRGB(255, 60, 60),
    },
    troll = {
        spinbot = false, speedhack = false, speedValue = 80,
        flyhack = false, noclip = false,
        infiniteJump = false, clickTp = false, antiAFK = false,
    },
    exploit = { scanRunning = false },
}

-- ══════════════════════════════════════════
--  UTILS
-- ══════════════════════════════════════════
local function getChar() return lp.Character end
local function getRoot()
    local c = getChar(); return c and c:FindFirstChild("HumanoidRootPart")
end
local function getHum()
    local c = getChar(); return c and c:FindFirstChildOfClass("Humanoid")
end

local function w2s(pos)
    local v, vis = cam:WorldToViewportPoint(pos)
    return Vector2.new(v.X, v.Y), vis, v.Z
end

local function getEnemies()
    local t = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p == lp then continue end
        if CFG.aimbot.teamCheck and p.Team == lp.Team then continue end
        table.insert(t, p)
    end
    return t
end

-- ══════════════════════════════════════════
--  AIMBOT — mousemoverel
-- ══════════════════════════════════════════
local silentTarget = nil

local function getBestTarget()
    local center   = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    local best     = nil
    local bestDist = CFG.aimbot.fov

    for _, p in ipairs(getEnemies()) do
        local char = p.Character; if not char then continue end
        local part = char:FindFirstChild(CFG.aimbot.target)
                  or char:FindFirstChild("HumanoidRootPart")
        if not part then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local screen, vis, depth = w2s(part.Position)
        if not vis or depth <= 0 then continue end
        local d = (screen - center).Magnitude
        if d < bestDist then bestDist = d; best = part end
    end
    return best
end

local fovCircle       = Drawing.new("Circle")
fovCircle.Visible     = false
fovCircle.Radius      = 120
fovCircle.Color       = Color3.fromRGB(0, 120, 255)
fovCircle.Thickness   = 1
fovCircle.Filled      = false
fovCircle.NumSides    = 64

RunService.RenderStepped:Connect(function()
    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    fovCircle.Position = center
    fovCircle.Radius   = CFG.aimbot.fov
    fovCircle.Visible  = CFG.aimbot.enabled and CFG.aimbot.showFov

    -- silent target update
    if CFG.aimbot.enabled and CFG.aimbot.silent then
        silentTarget = getBestTarget()
    else
        silentTarget = nil
    end

    -- aimbot normal
    if not CFG.aimbot.enabled or CFG.aimbot.silent then return end
    if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end

    local target = getBestTarget()
    if not target then return end

    local targetScreen, vis, depth = w2s(target.Position)
    if not vis or depth <= 0 then return end

    local deltaX = targetScreen.X - center.X
    local deltaY = targetScreen.Y - center.Y

    -- mousemoverel move o mouse fisicamente → câmera segue
    mousemoverel(
        deltaX * CFG.aimbot.smoothness,
        deltaY * CFG.aimbot.smoothness
    )
end)

-- ── silent aim hook ──
if hookmetamethod then
    local oldIndex
    oldIndex = hookmetamethod(game, "__index", function(self, key)
        if CFG.aimbot.enabled and CFG.aimbot.silent and silentTarget then
            if self == mouse then
                if key == "Hit"    then return CFrame.new(silentTarget.Position) end
                if key == "Target" then return silentTarget end
            end
        end
        return oldIndex(self, key)
    end)
end

-- ══════════════════════════════════════════
--  ESP
-- ══════════════════════════════════════════
local espObj = {}

local function clearESP(p)
    if espObj[p] then
        for _, d in pairs(espObj[p]) do pcall(function() d:Remove() end) end
        espObj[p] = nil
    end
end

local function mkLine(col, thick)
    local l = Drawing.new("Line")
    l.Color=col; l.Thickness=thick; l.Visible=false; return l
end
local function mkText(sz, col)
    local t = Drawing.new("Text")
    t.Size=sz; t.Color=col; t.Center=true; t.Outline=true; t.Visible=false; return t
end

local function makeESP(p)
    clearESP(p)
    local c = CFG.esp.colorEnemy
    espObj[p] = {
        bT=mkLine(c,1), bB=mkLine(c,1), bL=mkLine(c,1), bR=mkLine(c,1),
        name=mkText(13, Color3.new(1,1,1)),
        dist=mkText(11, Color3.fromRGB(180,180,255)),
        hpBG=mkLine(Color3.fromRGB(50,50,50), 3),
        hp  =mkLine(Color3.fromRGB(0,255,80),  3),
        trac=mkLine(c, 1),
    }
end

RunService.RenderStepped:Connect(function()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == lp then continue end
        if not espObj[p] then makeESP(p) end
        local t    = espObj[p]
        local char = p.Character
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        local head = char and char:FindFirstChild("Head")
        local root = char and char:FindFirstChild("HumanoidRootPart")

        if not CFG.esp.enabled or not head or not root then
            for _, d in pairs(t) do d.Visible=false end; continue
        end
        local dist = (root.Position - cam.CFrame.Position).Magnitude
        if dist > CFG.esp.maxDist then
            for _, d in pairs(t) do d.Visible=false end; continue
        end
        local sH, visH = w2s(head.Position + Vector3.new(0,.5,0))
        local sF, visF = w2s(root.Position  - Vector3.new(0,3,0))
        if not (visH and visF) then
            for _, d in pairs(t) do d.Visible=false end; continue
        end

        local ht = sH.Y - sF.Y
        local w  = math.abs(ht) * 0.4
        local top,bot,left,right = sH.Y, sF.Y, sH.X-w, sH.X+w

        t.bT.From=Vector2.new(left,top);  t.bT.To=Vector2.new(right,top); t.bT.Visible=CFG.esp.boxes
        t.bB.From=Vector2.new(left,bot);  t.bB.To=Vector2.new(right,bot); t.bB.Visible=CFG.esp.boxes
        t.bL.From=Vector2.new(left,top);  t.bL.To=Vector2.new(left,bot);  t.bL.Visible=CFG.esp.boxes
        t.bR.From=Vector2.new(right,top); t.bR.To=Vector2.new(right,bot); t.bR.Visible=CFG.esp.boxes

        t.name.Text=p.DisplayName
        t.name.Position=Vector2.new(sH.X,top-16); t.name.Visible=CFG.esp.names
        t.dist.Text=("%.0fm"):format(dist)
        t.dist.Position=Vector2.new(sH.X,bot+2);  t.dist.Visible=CFG.esp.distance

        if hum then
            local pct=hum.Health/hum.MaxHealth
            local bh=math.abs(ht); local bx=left-5
            t.hpBG.From=Vector2.new(bx,top); t.hpBG.To=Vector2.new(bx,bot); t.hpBG.Visible=CFG.esp.health
            t.hp.From=Vector2.new(bx,bot);   t.hp.To=Vector2.new(bx,bot-bh*pct)
            t.hp.Color=Color3.fromRGB(math.floor(255*(1-pct)),math.floor(255*pct),0)
            t.hp.Visible=CFG.esp.health
        end
        local sc=Vector2.new(cam.ViewportSize.X/2,cam.ViewportSize.Y)
        t.trac.From=sc; t.trac.To=sF; t.trac.Visible=CFG.esp.tracers
    end
end)
Players.PlayerRemoving:Connect(clearESP)

-- ══════════════════════════════════════════
--  TROLL
-- ══════════════════════════════════════════
UserInputService.JumpRequest:Connect(function()
    if CFG.troll.infiniteJump then
        local h=getHum()
        if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

RunService.Stepped:Connect(function()
    if CFG.troll.noclip then
        local c=getChar()
        if c then
            for _,p in ipairs(c:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide=false end
            end
        end
    end
end)

local spinConn
local function toggleSpin(on)
    if spinConn then spinConn:Disconnect(); spinConn=nil end
    if on then
        spinConn=RunService.RenderStepped:Connect(function()
            local r=getRoot()
            if r then r.CFrame=r.CFrame*CFrame.Angles(0,math.rad(15),0) end
        end)
    end
end

local flyBV,flyBG,flyConn
local function toggleFly(on)
    local r=getRoot(); if not r then return end
    if on then
        flyBV=Instance.new("BodyVelocity",r)
        flyBV.MaxForce=Vector3.new(1e5,1e5,1e5); flyBV.Velocity=Vector3.zero
        flyBG=Instance.new("BodyGyro",r)
        flyBG.MaxTorque=Vector3.new(1e5,1e5,1e5); flyBG.CFrame=r.CFrame
        flyConn=RunService.RenderStepped:Connect(function()
            local d=Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then d=d+cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then d=d-cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then d=d-cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then d=d+cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space)     then d=d+Vector3.yAxis end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then d=d-Vector3.yAxis end
            flyBV.Velocity=d.Magnitude>0 and d.Unit*60 or Vector3.zero
            flyBG.CFrame=cam.CFrame
        end)
    else
        if flyConn then flyConn:Disconnect(); flyConn=nil end
        if flyBV   then flyBV:Destroy();     flyBV=nil end
        if flyBG   then flyBG:Destroy();     flyBG=nil end
    end
end

mouse.Button1Down:Connect(function()
    if CFG.troll.clickTp then
        local r=getRoot()
        if r and mouse.Target then
            r.CFrame=CFrame.new(mouse.Hit.Position+Vector3.new(0,3,0))
        end
    end
end)

lp.Idled:Connect(function()
    if CFG.troll.antiAFK then
        local VU=game:GetService("VirtualUser")
        VU:Button2Down(Vector2.zero,cam.CFrame)
        task.wait(1)
        VU:Button2Up(Vector2.zero,cam.CFrame)
    end
end)

-- ══════════════════════════════════════════
--  EXPLOIT
-- ══════════════════════════════════════════
local scanLog={}
local function scanRemotes()
    scanLog={}
    local function rec(obj,d)
        if d>6 then return end
        for _,c in ipairs(obj:GetChildren()) do
            if c:IsA("RemoteEvent") or c:IsA("RemoteFunction") then
                table.insert(scanLog,{type=c.ClassName,path=c:GetFullName(),obj=c})
            end
            rec(c,d+1)
        end
    end
    rec(game,1); return scanLog
end

if hookmetamethod then
    local oldNC
    oldNC=hookmetamethod(game,"__namecall",function(self,...)
        local m=getnamecallmethod()
        if (m=="FireServer" or m=="InvokeServer") and CFG.exploit.scanRunning then
            table.insert(scanLog,{type="LIVE",path=self:GetFullName(),obj=self})
        end
        return oldNC(self,...)
    end)
end

local function tryRemotes(keys,...)
    local args={...}
    for _,key in ipairs(keys) do
        local r=ReplicatedStorage:FindFirstChild(key,true)
        if r then
            pcall(function()
                if r:IsA("RemoteEvent") then r:FireServer(table.unpack(args))
                else r:InvokeServer(table.unpack(args)) end
            end)
        end
    end
end

