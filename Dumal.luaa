local so=Instance.new("ScrollingFrame")
so.Size=UDim2.new(1,0,0,120); so.BackgroundColor3=Color3.fromRGB(8,8,16)
so.BorderSizePixel=0; so.ScrollBarThickness=2
so.AutomaticCanvasSize=Enum.AutomaticSize.Y
so.CanvasSize=UDim2.new(0,0,0,0); so.Parent=pgExploit
Instance.new("UICorner",so).CornerRadius=UDim.new(0,5)
Instance.new("UIListLayout",so).SortOrder=Enum.SortOrder.LayoutOrder
local function logScan(msg)
    local l=makeLabel(so,msg); l.LayoutOrder=#so:GetChildren()
end
makeBtn(pgExploit,"🔍 Escanear Remotes",function()
    for _,c in ipairs(so:GetChildren()) do if c:IsA("TextLabel") then c:Destroy() end end
    local r=scanRemotes()
    logScan(("[dumal] %d remotes"):format(#r))
    for _,v in ipairs(r) do logScan("  ["..v.type.."] "..v.path) end
end)
makeToggle(pgExploit,"Live Hook","exploit","scanRunning")
